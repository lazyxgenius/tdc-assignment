# Required. The app reads profiles with Gemini.
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional. Used only if Gemini fails. Leave blank to skip the fallback.
GROQ_API_KEY=

# gemini-2.5-flash is closed to new API keys. gemini-3.5-flash is a current Flash model.
GEMINI_MODEL=gemini-3.5-flash
GROQ_MODEL=openai/gpt-oss-20b
